# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets.

# Google Gemini (Stage 7). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Shared PIN for usher and organizer pages (Stage 4)
STAFF_PIN=

# Database. Leave empty locally to use the launchpad.db file.
# For Vercel, create a Turso database and paste its URL and token here.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
